# ============================================================
# .gitignore — Selective Evidence-Guided Hallucination
#              Correction Framework
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# ── Virtual Environments ──────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ── Environment Variables (contains API keys) ─────────────────
.env
# .env.example is intentionally tracked (no real secrets)

# ── Logs (generated at runtime) ───────────────────────────────
logs/
*.log

# ── Temporary diagnostics ─────────────────────────────────────
results/audit_archive/
results/debug/
results/diagnostics/
results/temp/
results/cache/

# ── Benchmark investigation artifacts ─────────────────────────
audit_*.json
audit_*.csv
audit_*.txt
support_diagnostic_*
retrieval_audit_*
forensic_audit_*
threshold_analysis_*
calibration_*
diagnostic_*
debug_*

# ── Targeted cache exclusions (avoid blanket *.pkl / *.pickle) ─
results/audit_archive/*.pkl
results/audit_archive/*.pickle
results/cache/*.pkl
results/cache/*.pickle
cache/*.pkl
tmp/*.pkl
scratch/*.pkl

# ── HuggingFace / Torch Model Cache ──────────────────────────
.cache/
models/
*.bin
*.safetensors
*.ckpt
*.pt
*.pth

# ── Jupyter Notebooks ─────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── pytest / Testing ──────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── Build / Distribution ──────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
MANIFEST
wheels/

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── IDE files ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Temporary experiment outputs ──────────────────────────────
tmp/
temp/
scratch/
experiments/

# ── Preserved & Tracked Benchmark Deliverables ────────────────
# Keep the folder itself tracked
!results/.gitkeep

# Explicitly track essential final benchmark data and paper figures
!results/multiclaim_results.json
!results/multiclaim_metrics.csv
!results/final_figures/
!results/final_figures/*
!results/final_figures/**/*

