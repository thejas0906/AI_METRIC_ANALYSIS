# .env.example
# ============================================================
# Environment Variables for Hallucination Correction Framework
# ============================================================
# Copy this file to .env and fill in your values.
# The framework works WITHOUT any API key using the local backend.
# ============================================================

# OpenAI API Key (optional — for higher-quality claim corrections)
# Get your key at: https://platform.openai.com/api-keys
# If not set, the framework uses the rule-based local corrector.
OPENAI_API_KEY=

# OpenAI model to use for corrections (default: gpt-3.5-turbo)
# Options: gpt-3.5-turbo | gpt-4 | gpt-4o
OPENAI_MODEL=gpt-3.5-turbo

# NLI device (cpu or cuda)
# Use "cuda" if you have an NVIDIA GPU with CUDA support
NLI_DEVICE=cpu

# Log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
